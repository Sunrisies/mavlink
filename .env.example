# MAVLink 连接配置
MAVLINK_CONN_STR=udpin:127.0.0.1:23445

# Web 服务器配置
WEB_HOST=0.0.0.0
WEB_PORT=8080

# MQTT 配置
MQTT_HOST=mqtt.example.com
MQTT_PORT=1883
MQTT_KEEP_ALIVE=5
MQTT_MAX_PACKET_SIZE=10485760

# MQTT 主题配置
MQTT_TOPIC_INCOMING=mavlink/incoming
MQTT_TOPIC_SEND=send
MQTT_TOPIC_GET_LIST=get_list
MQTT_TOPIC_SET_LIST=set_list
